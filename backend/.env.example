############################
# Django / Backend (.env)
# Copy these into Render
############################

# SECURITY
SECRET_KEY=django-insecure-change-this-in-production
ENVIRONMENT=production
DEBUG=False

# Hosts and CORS
# Replace placeholders with your real domains.
ALLOWED_HOSTS=api.yourdomain.com,your-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# Database (Render Postgres)
DATABASE_URL=postgresql://user:password@host:port/dbname

# OpenRouter (PRIMARY AI PROVIDER)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Default fast model: Gemini 2.0 Flash on OpenRouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
PREFER_OPENROUTER=True

# Optional Gemini direct (only if you want Google SDK fallback)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# AI timeouts (override only if needed; otherwise use defaults)
# GEMINI_REQUEST_TIMEOUT_SECONDS=35
# OPENROUTER_CONNECT_TIMEOUT_SECONDS=8
# OPENROUTER_READ_TIMEOUT_SECONDS=45
# OPENROUTER_READ_TIMEOUT_LONG_SECONDS=90
# AI_REQUEST_DEADLINE_SECONDS=100

# Enterprise inquiries
DEFAULT_FROM_EMAIL=noreply@edureach.app
ENTERPRISE_INQUIRY_EMAIL=hello@edureach.app

# Media uploads (assessment answer images)
# You can usually leave MEDIA_ROOT at its default; this is here for clarity.
# MEDIA_ROOT=/opt/render/project/media
# Let Django serve media files in production (OK for early Render deployment).
SERVE_MEDIA_FILES=True

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/1
