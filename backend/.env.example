
# SECURITY
SECRET_KEY=replace-with-a-long-random-secret-key
ENVIRONMENT=production
DEBUG=False

# Hosts and CORS — replace with your actual domains
ALLOWED_HOSTS=api.edureach.app,edureach.app
CORS_ALLOWED_ORIGINS=https://edureach.app,https://www.edureach.app

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname

# OpenRouter (PRIMARY AI PROVIDER)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
PREFER_OPENROUTER=True

# Optional Gemini direct fallback
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL_NAME=gemini-2.5-flash

# AI timeouts (defaults are fine; override only if needed)
# GEMINI_REQUEST_TIMEOUT_SECONDS=35
# OPENROUTER_CONNECT_TIMEOUT_SECONDS=8
# OPENROUTER_READ_TIMEOUT_SECONDS=45
# OPENROUTER_READ_TIMEOUT_LONG_SECONDS=90
# AI_REQUEST_DEADLINE_SECONDS=100

# Enterprise inquiries
DEFAULT_FROM_EMAIL=noreply@edureach.app
ENTERPRISE_INQUIRY_EMAIL=hello@edureach.app

# Email delivery (SMTP / SendGrid)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key-here

# Media uploads
SERVE_MEDIA_FILES=True
# MEDIA_ROOT=/var/www/edureach/media

# Paystack (card / bank payments)
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key

# M-Pesa / Daraja
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://api.edureach.app/api/payments/mpesa/callback/

# Redis (optional, for caching/Celery)
# REDIS_URL=redis://localhost:6379/1

# YouTube cookies (helps with datacenter IP restrictions)
# YOUTUBE_COOKIES_FILE=/etc/secrets/youtube_cookies.txt
